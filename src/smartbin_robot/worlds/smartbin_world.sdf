<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="smartbin_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_walls">
      <static>true</static>
      <link name="north_wall">
        <pose>0 3.75 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>7.5 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>7.5 0.2 2</size></box></geometry></visual>
      </link>
      <link name="south_wall">
        <pose>0 -3.75 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>7.5 0.2 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>7.5 0.2 2</size></box></geometry></visual>
      </link>
      <link name="east_wall">
        <pose>3.75 0 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 7.5 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 7.5 2</size></box></geometry></visual>
      </link>
      <link name="west_wall">
        <pose>-3.75 0 1 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.2 7.5 2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 7.5 2</size></box></geometry></visual>
      </link>
    </model>

    <model name="countertops">
      <static>true</static>
      <link name="north_countertop">
        <pose>2.25 3.0 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>3 1.5 1</size></box></geometry></collision>
        <visual name="visual">
        <geometry><box><size>3 1.5 1</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
      </link>
      <link name="east_countertop">
        <pose>3.125 1 0.5 0 0 1.57</pose>
        <collision name="collision"><geometry><box><size>3 1.25 1</size></box></geometry></collision>
        <visual name="visual">
        <geometry><box><size>3 1.25 1</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0.4 0.4 0.4 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="home_position">
      <static>true</static>
      <pose>0 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>0.001</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.0 0.8 0.0 1</ambient>
            <diffuse>0.0 0.8 0.0 1</diffuse>
            <specular>0.0 0.8 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing person</uri>
      <name>human_target</name>
      <pose>2.0 2.0 0 0 0 3.14</pose>
    </include>

  </world>
</sdf>