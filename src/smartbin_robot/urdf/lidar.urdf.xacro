<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="lidar" params="suffix parent xyz rpy">
    <link name="lidar_link_${suffix}">
      <visual>
        <geometry>
          <cylinder radius="0.02" length="0.02" />
        </geometry>
        <material name="red">
          <color rgba="0.4 0 0.1 1" />
        </material>
      </visual>
    </link>

    <joint name="lidar_joint_${suffix}" type="fixed">
      <parent link="${parent}" />
      <child link="lidar_link_${suffix}" />
      <origin xyz="${xyz}" rpy="${rpy}" />
      <axis xyz="0 0 1" />
    </joint>

     <gazebo reference="lidar_link_${suffix}">
      <sensor name='gpu_lidar' type='gpu_lidar'>
        <topic>/scan</topic>
        <update_rate>10</update_rate> <!-- Increased update rate -->
        <gz_frame_id>lidar_link_${suffix}</gz_frame_id>
        <ray>
          <scan>
            <horizontal>
              <samples>180</samples>
              <resolution>1</resolution>
              <!-- Range: -pi/2 (-90 deg, right side) to +pi/2 (+90 deg, left side) -->
              <min_angle>-1.5707963</min_angle>
              <max_angle>1.5707963</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.08</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <always_on>true</always_on>
        <visualize>true</visualize> <!-- Makes the blue laser rays visible in Gazebo! -->
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>